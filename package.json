{
  "name": "aiman",
  "version": "1.8.0",
  "description": "AiMAN — self-hosted web UI and session manager for opencode.",
  "type": "module",
  "main": "desktop/main.cjs",
  "bin": {
    "aiman": "bin/aiman.mjs"
  },
  "files": [
    "bin",
    "server",
    "dist",
    "desktop",
    "scripts",
    "deploy",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "bun run server/src/index.ts",
    "dev": "bun run --watch server/src/index.ts",
    "dev:web": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "build:web": "bun install --cwd web && bun run --cwd web build",
    "typecheck": "bunx tsc -p web/tsconfig.json --noEmit",
    "prepublishOnly": "bun run build:web",
    "desktop": "electron desktop/main.cjs",
    "desktop:dir": "electron-builder --win --x64 --dir",
    "desktop:build": "electron-builder --win --x64"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "opencode",
    "sessions",
    "web-ui",
    "ai",
    "agents"
  ],
  "author": "spacewalkingninja",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spacewalkingninja/aiman.git"
  },
  "bugs": {
    "url": "https://github.com/spacewalkingninja/aiman/issues"
  },
  "homepage": "https://github.com/spacewalkingninja/aiman#readme",
  "build": {
    "appId": "ai.aiman.desktop",
    "productName": "aiman",
    "asar": true,
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "aiman/bin"
      },
      {
        "from": "server",
        "to": "aiman/server"
      },
      {
        "from": "dist",
        "to": "aiman/dist"
      },
      {
        "from": "package.json",
        "to": "aiman/package.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
